# Copy to .env and fill in. Values are held blank here on purpose: this file is tracked,
# so it is the published bootstrap list of the names a clone needs — never the values.
# The secret guard fails the commit if any value is non-empty.

# Twilio — https://console.twilio.com (Account SID and Auth Token on the console home)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SPAIN_PHONE_NUMBER=

# Gmail — the OAuth client lives in messaging/gmail/credentials.json, which is not tracked.
# These two are addresses, not secrets, but they are personal data: keeping them here means
# they are no longer committed in the script (see docs/secrets.md §1).
GMAIL_SENDER=
GMAIL_RECIPIENT=
